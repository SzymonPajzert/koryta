# Starts the night run at 02:30 Warsaw, half an hour after the Firestore
# export - on the VM the instance schedule has just booted (at 02:15), or on
# one somebody left running, which is then powered off afterwards as on any
# other night (unless /etc/koryta/stay-up).
#
# Persistent: a boot after 02:30 - the schedule may start the VM up to 15
# minutes late - catches up at once. A boot much later (somebody starting the
# VM at noon after a missed night) catches up too, and night.sh then refuses to
# run outside the night window.
#
# On the last Sunday of March 02:30 does not exist: the schedule boots the VM
# at 03:15 then, and the night starts at 03:30.

[Unit]
Description=Start the koryta night run at 02:30 Warsaw

[Timer]
OnCalendar=*-*-* 02:30:00 Europe/Warsaw
Persistent=true

[Install]
WantedBy=timers.target
