# /etc/koryta/nightly.env - the environment of koryta-nightly.service.
# setup-vm.sh writes it once from this example and never overwrites it, so
# edit the copy on the VM; systemd reads it at the start of each night.

# The code the night runs, fetched and checked out afresh every night.
# origin/main runs whatever was merged that day; a tag holds it still.
KORYTA_REF=origin/main

# Pipeline backups go to the shared cache under user=main: the night's
# outputs are the ones everybody else restores (stores.storage).
USERNAME=main

# The people import signs in to koryta.pl as this robot (stores.koryta_login);
# "pipeline" in the uid is what makes the site count its revisions as automated.
KORYTA_PIPELINE_UID=pipeline-people-import

# Secrets night.sh reads from Secret Manager at the start of each night.
KORYTA_PESEL_SECRET=koryta-pesel-salt
KORYTA_WEB_KEY_SECRET=firebase-web-api-key
# The rejestr.io key the paid step buys with; this name is the default. Empty
# switches the step off.
# KORYTA_REJESTR_SECRET=rejestr-io-key

# Extra arguments for koryta_nightly (see `koryta_nightly --help`). The nights
# send up to 100 people (--max-uploads). To have them build and count the
# people and send none: KORYTA_NIGHTLY_ARGS=--people-dry-run. To send more:
# KORYTA_NIGHTLY_ARGS=--max-uploads 300
# They buy up to 50 rejestr.io calls a day (--paid-max-calls, 0.05 PLN each);
# 0 buys none: KORYTA_NIGHTLY_ARGS=--paid-max-calls 0
# KORYTA_NIGHTLY_ARGS=

# The night window night.sh accepts, Warsaw time (HHMM).
# KORYTA_NIGHT_FROM=0300
# KORYTA_NIGHT_UNTIL=0800
# Warsaw time (HH:MM) after which no step but compress and tidy starts.
# KORYTA_NIGHT_STOP_BY=08:30
