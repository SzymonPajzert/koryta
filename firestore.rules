rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /nodes/{nodeId} {
      allow read: if resource.data.type == "article" || resource.data.type == "person" || resource.data.type == "place" || resource.data.type == "topic";
      allow create: if request.auth != null && resource.data.revision_id == null;
    }

    match /notes/{noteId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null && request.resource.data.userUid == request.auth.uid;

      // A note written by a pipeline rather than by a contributor - today the
      // opening paragraph of somebody's Wikipedia article, copied onto their
      // page by `PeopleWikiNotes`. Nobody signs in as a pipeline, so the check
      // above can never cover these; they are uploaded by whoever runs
      // `koryta_uploader --type note`, writing under the pipeline's uid, and
      // are limited to the datascience group like the votes below.
      allow create, update: if request.auth != null
          && request.auth.token.datascience == true
          && isPipelineNote(noteId, request.resource.data);
      // A page that no longer qualifies loses the note rather than keeping a
      // stale one, so the reconciliation deletes; `resource` is the document
      // as stored, since a delete carries no payload.
      allow delete: if request.auth != null
          && request.auth.token.datascience == true
          && isPipelineNote(noteId, resource.data);
    }

    // What a pipeline is allowed to write into `notes`. The same two questions
    // `isPipelineVote` asks - the uid reads as a robot's, and the document id
    // spells out the node and uid it carries, so this branch cannot be used to
    // write a note in somebody else's name - plus one this collection needs on
    // its own: a note is prose shown on a person's page, so what it says is
    // checked too.
    //
    // One entry, because a pipeline says one thing about a person, and only
    // the three fields its author owns. `articleNodeId` and the `admin*` fields
    // are the site's own bookkeeping about an entry, and a writer that could
    // set them would be triaging its own note. `kind` has to be "source" -
    // something to read - because the other kinds mean "this data is wrong" and
    // put the entry on a queue for a person to act on; a robot does not get to
    // file work for somebody else that way.
    function isPipelineNote(noteId, data) {
      return data.nodeId is string
          && data.userUid is string
          && data.userUid.matches('.*pipeline.*')
          && noteId == data.nodeId + '_' + data.userUid
          && data.sources is list
          && data.sources.size() == 1
          && data.sources[0].keys().hasOnly(['url', 'note', 'kind'])
          && data.sources[0].note is string
          && data.sources[0].kind == 'source';
    }

    match /users/{userId} {
      allow read, write: if request.auth.uid == userId;
    }

    // What a contributor concluded about one entry of the QA changelog
    // (frontend/shared/qa.ts). Readable to anyone signed in, because the point
    // of the page is seeing what somebody else already reported; writable only
    // as yourself. The document id spells out which entry and whose verdict it
    // is, so - as with votes - one person cannot file a verdict under another
    // person's name, and cannot hold two verdicts on the same entry.
    match /qaChecks/{checkId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
          && checkId == request.resource.data.itemId + '_' + request.auth.uid
          && request.resource.data.userUid == request.auth.uid;
      // A verdict is changed by writing the other status, never removed - a
      // reported problem should not be able to disappear without someone
      // saying it works now.
      allow delete: if false;
    }

    match /revisions/{revisionId} {
      allow read: if true;
      // `update_user` has to be the caller's own uid. It is not decoration: it
      // names the author, and approving or rejecting a revision now sends that
      // person an email. Left unchecked, anyone signed in could file a
      // revision attributed to somebody else and have an admin's review
      // deliver attacker-written text to that person's inbox.
      //
      // Nothing in the app creates a revision from the browser - every
      // proposal goes through /api/revisions/create, and the admin SDK is not
      // subject to these rules - so this only closes the direct path.
      allow create: if request.auth != null
          && request.resource.data.update_user == request.auth.uid;
    }

    // The outgoing mail queue the Trigger Email extension delivers from. Every
    // document is somebody's email address next to a message written on their
    // behalf, so no client touches it: it is written by the server (admin SDK,
    // which these rules do not apply to) and read by the extension.
    // Unmatched paths are denied anyway - this is here so the collection is not
    // mistaken for an oversight and opened up later.
    match /mail/{mailId} {
      allow read, write: if false;
    }

    // One document per finished UTC day, holding what everybody did on it -
    // written and read only by /api/stats/activity through the admin SDK, which
    // these rules do not apply to. Closed to the client on both sides: reading
    // it would hand out a uid-keyed map of who did what, which is the very
    // thing the endpoint masks before it answers, and writing it would let
    // anybody dictate the numbers on the stats page. The page reads the
    // endpoint, never this.
    match /activityDaily/{day} {
      allow read, write: if false;
    }

    match /extractions/{extractionId} {
      allow read: if request.auth != null && request.auth.token.datascience == true;
      allow write: if false;
    }

    // Pages captured from someone's browser. Written only by /api/ingest/page
    // and by the extractor, both of which hold admin credentials and so are not
    // subject to these rules at all — the client reads through /api/pages,
    // which applies the same check server side.
    match /articlePages/{pageId} {
      allow read: if request.auth != null && request.auth.token.datascience == true;
      allow write: if false;
    }

    // A score written by a scoring model rather than cast by a person: stored
    // under the model's own uid, which is what `isPipelineUid` on both the
    // frontend and the scrapers reads as non-human. Requiring the document id
    // to spell out the same nodeId and uid is what stops this branch from being
    // used to vote in somebody else's name.
    function isPipelineVote(voteId, data) {
      return data.nodeId is string
          && data.userUid is string
          && data.userUid.matches('.*pipeline.*')
          && voteId == data.nodeId + '_' + data.userUid;
    }

    // Feedback is written by anyone, including signed-out visitors, and read
    // only by admins - neither of which is expressible here. Everything goes
    // through /api/feedback/* with the admin SDK, so the client SDK is shut
    // out entirely. Spelled out rather than left to the default deny so it is
    // clear this is deliberate.
    match /feedback/{feedbackId} {
      allow read, write: if false;
    }

    // Daily counters bounding how much feedback gets forwarded to Slack.
    // Server-side only; a client that could read these would learn how close
    // the cap is, and one that could write them would lift it.
    match /feedbackLimits/{day} {
      allow read, write: if false;
    }

    match /votes/{voteId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null
          && voteId.matches('.*_' + request.auth.uid)
          && request.resource.data.userUid == request.auth.uid;

      // Nobody signs in as a scoring model, so the check above can never cover
      // the pipeline's own scores - they are uploaded by whoever runs
      // `koryta_uploader --type score`, writing under the model's uid. Limited
      // to the datascience group, the same gate the extractions they are
      // computed from sit behind.
      allow create, update: if request.auth != null
          && request.auth.token.datascience == true
          && isPipelineVote(voteId, request.resource.data);
      // A model that no longer rates somebody retracts the score, so the
      // reconciliation is a delete rather than a zero; `resource` is the
      // document as stored, since a delete carries no payload.
      allow delete: if request.auth != null
          && request.auth.token.datascience == true
          && isPipelineVote(voteId, resource.data);
      }
    }
  }