{
  "about": "Role chips for posts read off BIP declarations, shared by the site (shared/declarationEmployment.ts) and the pipeline (data/pipelines/src/util/declaration_roles.py). A chip's id never changes; its family is what a declared post is matched by. Family patterns are regular expressions over a name folded to lower-case ASCII words (no diacritics, every run of other characters one space), tried in this order after the prefixes („p.o.”, then an ordinal such as „I Zastępca”) are cut off, each once and in their order; the first family with a matching pattern is the name's. A deputy is „zastępca”, „Z-ca” or the genitive „Z-cy”. tests/shared/declarationEmploymentRoleFamilies.json holds names both sides fold.",
  "prefixes": [
    "^p o ",
    "^pelniac\\w* obowiazki ",
    "^(i|ii|iii|pierwsz\\w*|drug\\w*|trzec\\w*) "
  ],
  "families": [
    {
      "id": "supervisory_board",
      "board": true,
      "patterns": [
        "\\brad\\w* (nadzorcz|spoleczn)",
        "\\bkomisj\\w* rewizyjn\\w*\\b(?! (rad\\w* (gmin|miast|miejsk|powiat|dzielnic|osiedl)|sejmik))"
      ]
    },
    { "id": "commercial_proxy", "board": true, "patterns": ["^prokur"] },
    { "id": "attorney", "board": true, "patterns": ["^pelnomocni"] },
    {
      "id": "deputy_mayor",
      "board": false,
      "patterns": [
        "^(zastepc\\w*|z ?c[ay]) (wojt|burmistrz|prezydent)",
        "^wice ?(wojt|burmistrz|prezydent)"
      ]
    },
    {
      "id": "mayor",
      "board": false,
      "patterns": ["^(wojt|burmistrz|prezydent)"]
    },
    {
      "id": "office_deputy",
      "board": false,
      "patterns": [
        "^(wicestarost|wicemarszal|wicewojewod|wiceminist|podsekretarz stanu|sekretarz stanu)",
        "^(zastepc\\w*|z ?c[ay]) (starost|marszal|wojewod|ministr)"
      ]
    },
    {
      "id": "office_head",
      "board": false,
      "patterns": ["^(starosta|marszalek|wojewoda|minister)\\b"]
    },
    {
      "id": "deputy_director",
      "board": false,
      "patterns": [
        "^(zastepc\\w*|z ?c[ay]) (dyrektor|komendant)",
        "^wice ?(dyrektor|komendant)"
      ]
    },
    { "id": "director", "board": false, "patterns": ["^(dyrektor|komendant)"] },
    {
      "id": "management_board",
      "board": true,
      "patterns": [
        "^(wice)?prezes",
        "^(zastepc\\w*|z ?c[ay]) prezes",
        "^czlon\\w* (rady )?zarzad",
        "^przewodnicz\\w* zarzad",
        "^zarzad\\b"
      ]
    },
    {
      "id": "secretary",
      "board": false,
      "patterns": ["^sekretarz\\b(?! (rady|komisji|zarzadu|redakcji|szkoly))"]
    },
    { "id": "treasurer", "board": false, "patterns": ["^skarbnik\\b"] },
    {
      "id": "advisor",
      "board": false,
      "patterns": [
        "^doradca$",
        "^doradc\\w* (wojewod|starost|marszal|prezydent|burmistrz|wojt|minist)"
      ]
    },
    {
      "id": "manager",
      "board": false,
      "patterns": [
        "^((zastepc\\w*|z ?c[ay]) )?(kierownik|kierowniczk|naczelnik|koordynator|glown\\w* ksiegow)"
      ]
    },
    {
      "id": "staff",
      "board": false,
      "patterns": [
        "^((starsz|mlodsz|glown)\\w* )?(pracowni|nauczyciel|specjalist|inspektor|podinspektor|referent|ekspert|asystent|pedagog|wychowawc|urzednik|informatyk|wykladowc|lekarz|pielegniar|doradc)"
      ]
    }
  ],
