{
  "manifest_version": 3,
  "name": "Koryta — zapisz artykuł",
  "version": "0.1.0",
  "description": "Zapisuje czytany artykuł w archiwum koryta.pl i wyciąga z niego fakty — także zza paywalla.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://koryta.pl/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "externally_connectable": {
    "matches": ["https://koryta.pl/*", "https://*.koryta.pl/*"]
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Zapisz artykuł w koryta.pl",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["http://localhost/*", "http://127.0.0.1/*"],
      "js": ["bridge.js"],
      "run_at": "document_idle"
    }
  ]
}
